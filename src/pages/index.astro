---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Colegio Marista San Jose, Mendoza">
  <main class="container">
    <div class="card">

      <div class="logo-area">
        <img src="/favicon.png" alt="Logo" class="logo-img" />
      </div>

      <h1 class="title" id="page-title">Colegio Marista San José, Mendoza.</h1>

      <div class="links-grid" id="links-container">
        <!-- HOME -->
        <div class="view active" data-view="home">
          <a href="#" class="btn btn-ocre" data-navigate="inscripciones">INSCRIPCIONES 2026</a>
          <a href="#" class="btn btn-white" data-navigate="secretaria">SECRETARÍA</a>
          <a href="#" class="btn btn-ocre" data-navigate="administracion">ADMINISTRACIÓN</a>
          <a href="#" class="btn btn-white" data-navigate="servicio">SERVICIOS</a>
          <a href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x967e0808a59a8f81:0x81beed916d1ab13e?sa=X&ved=1t:8290&ictx=111" target="_blank" class="btn btn-ocre">VILLA MARISTA</a>
          <a href="https://www.cmsjm.org.ar" target="_blank" class="btn btn-white">WEB</a>
          <a href="https://www.google.com/maps/search/Av.+Champagnat+2980,+M5500+Mendoza,+Argentina" target="_blank" class="btn btn-ocre">¿DÓNDE ESTAMOS?</a>
        </div>

        <!-- INSCRIPCIONES -->
        <div class="view" data-view="inscripciones">
          <a href="https://wa.me/5492615407373" target="_blank" class="btn btn-ocre">NIVEL INICIAL</a>
          <a href="https://wa.me/5492615336395" target="_blank" class="btn btn-white">NIVEL PRIMARIO</a>
          <a href="https://wa.me/5492616512025" target="_blank" class="btn btn-ocre">NIVEL SECUNDARIO</a>
        </div>

        <!-- SECRETARIA -->
        <div class="view" data-view="secretaria">
          <a href="tel:" class="btn btn-ocre">TELÉFONO FIJO</a>
          <a href="https://wa.me/5492613000073" target="_blank" class="btn btn-white">CELULAR</a>
        </div>

        <!-- ADMINISTRACION -->
        <div class="view" data-view="administracion">
          <a href="https://app.aulica.com.ar/login.html?idCompany=820" target="_blank" class="btn btn-ocre">PAGO FACTURAS</a>
          <a href="https://wa.me/5492615344622" target="_blank" class="btn btn-white">CONTACTO</a>
        </div>

        <!-- SERVICIO -->
        <div class="view" data-view="servicio">
          <a href="https://wa.me/5492615876566" target="_blank" class="btn btn-ocre">LIBRERÍA</a>
          <a href="https://wa.me/5492616950182" target="_blank" class="btn btn-white">KIOSKO/COMEDOR</a>
          <a href="#" class="btn btn-ocre" data-navigate="ropero">ROPERO</a>
        </div>

        <!-- ROPERO -->
        <div class="view" data-view="ropero">
          <img src="/horario-ropero.jpeg" alt="Horario Ropero" class="ropero-img" />
          <button class="ropero-back-btn" id="ropero-back-btn">← Volver</button>
        </div>
      </div>

      <a href="#" class="back-link" id="back-btn" style="display:none;">Volver al inicio</a>
    </div>
  </main>
</Layout>

<script>
  const titles: Record<string, string> = {
    home: "Colegio Marista San José, Mendoza",
    inscripciones: "Inscripciones",
    secretaria: "Secretaría",
    administracion: "Administración",
    servicio: "Servicio",
    ropero: "Ropero",
    web: "Web",
    villamarista: "Villa Marista",
  };

  const container = document.getElementById("links-container")!;
  const titleEl = document.getElementById("page-title")!;
  const backBtn = document.getElementById("back-btn")!;
  const logoArea = document.querySelector(".logo-area") as HTMLElement;
  const card = document.querySelector(".card") as HTMLElement;
  let current = "home";

  function navigate(view: string) {
    const prev = container.querySelector(`.view[data-view="${current}"]`) as HTMLElement;
    const next = container.querySelector(`.view[data-view="${view}"]`) as HTMLElement;

    if (!prev || !next || view === current) return;

    prev.classList.add("fade-out");

    setTimeout(() => {
      prev.classList.remove("active", "fade-out");
      next.classList.add("active", "fade-in");
      titleEl.textContent = titles[view] || "Colegio Marista San José, Mendoza";
      current = view;

      const isRopero = view === "ropero";
      logoArea.style.display = isRopero ? "none" : "flex";
      titleEl.style.display = isRopero ? "none" : "block";
      backBtn.style.display = view === "home" ? "none" : "inline-block";
      card.classList.toggle("card-ropero", isRopero);

      setTimeout(() => next.classList.remove("fade-in"), 300);
    }, 250);
  }

  container.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const nav = target.closest("[data-navigate]") as HTMLElement;
    if (nav) {
      e.preventDefault();
      navigate(nav.dataset.navigate!);
    }
  });

  backBtn.addEventListener("click", (e) => {
    e.preventDefault();
    navigate("home");
  });

  const roperoBackBtn = document.getElementById("ropero-back-btn")!;
  roperoBackBtn.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    navigate("home");
  });
</script>

<style>
  .view {
    display: none;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .view.active {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }

  .view.fade-out {
    opacity: 0;
    transform: translateY(-8px);
  }

  .view.fade-in {
    opacity: 0;
    transform: translateY(8px);
  }

  .ropero-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .view[data-view="ropero"] {
    gap: 0;
    justify-content: center;
    align-items: center;
    flex: 1;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0;
    margin: 0;
    border-radius: 0;
    overflow: hidden;
    z-index: 100;
  }

  .card-ropero {
    padding: 0 !important;
    overflow: hidden;
    background: transparent !important;
    box-shadow: none !important;
    border: none !important;
    border-radius: 0 !important;
    max-width: 100% !important;
  }

  .ropero-back-btn {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.85);
    color: #0a1f33;
    border: none;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    z-index: 110;
    backdrop-filter: blur(4px);
  }

  .ropero-back-btn:active {
    transform: scale(0.95);
  }
</style>
