---
import Layout from '../layouts/Layout.astro';

interface Link {
  title: string;
  type: 'whatsapp' | 'call';
  phone?: string;
  isOcre: boolean;
}

const secretariaLinks: Link[] = [
  { title: "TELÉFONO FIJO", phone: "", type: "call", isOcre: true },
  { title: "CELULAR", phone: "5492613000073", type: "whatsapp", isOcre: false },
];

const getHref = (link: Link) => {
  return link.type === 'whatsapp' 
    ? `https://wa.me/${link.phone}` 
    : `tel:${link.phone}`;
};
---

<Layout title="Secretaría - San José de Maristas">
  <main class="container">
    <div class="card">
      <div class="logo-area">
        <img src="/favicon.png" alt="Logo" class="logo-img" />
      </div>

      <h1 class="title">Secretaría</h1>

      <div class="links-grid">
        {secretariaLinks.map((link) => (
          <a 
            href={getHref(link)} 
            class={`btn ${link.isOcre ? 'btn-ocre' : 'btn-white'}`}
          >
            {link.title}
          </a>
        ))}
      </div>

      <a href="/" class="back-link">Volver al inicio</a>
    </div>
  </main>
</Layout>

